<?xml version="1.0"?>
<!-- Section: ROS 2 metadata for both Carry My Luggage YASMIN graphs. -->
<package format="3">
  <name>carry_my_luggage_yasmin</name>
  <version>0.1.0</version>
  <description>YASMIN ports of the Carry My Luggage phase-one and follow-demo state machines.</description>
  <maintainer email="yanjiun68@example.com">yanjiun68</maintainer>
  <license>Apache-2.0</license>

  <!-- Section: Python build system and runtime state-machine dependencies. -->
  <buildtool_depend>ament_python</buildtool_depend>
  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>person_follower_master</exec_depend>
  <exec_depend>putrabot_interfaces</exec_depend>
  <exec_depend>python3-yaml</exec_depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>std_srvs</exec_depend>
  <exec_depend>voice_interfaces</exec_depend>
  <exec_depend>yasmin</exec_depend>
  <exec_depend>yasmin_ros</exec_depend>
  <exec_depend>yasmin_viewer</exec_depend>

  <!-- Section: Package tests use the standard ROS Python lint/test stack. -->
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
