<?xml version="1.0"?>
<robot name="omni_robot" xmlns:xacro="http://www.ros.org/wiki/xacro">
  <!-- This is deliberately a joint-space group. A two-axis head cannot solve
       an arbitrary six-degree-of-freedom end-effector pose. -->
  <group name="camera_head">
    <joint name="head_yaw_joint"/>
    <joint name="head_pitch_joint"/>
  </group>

  <group_state name="Center" group="camera_head">
    <joint name="head_yaw_joint" value="0"/>
    <joint name="head_pitch_joint" value="0"/>
  </group_state>
  <group_state name="Left" group="camera_head">
    <joint name="head_yaw_joint" value="0.5"/>
    <joint name="head_pitch_joint" value="0"/>
  </group_state>
  <group_state name="Right" group="camera_head">
    <joint name="head_yaw_joint" value="-0.5"/>
    <joint name="head_pitch_joint" value="0"/>
  </group_state>
  <group_state name="Up" group="camera_head">
    <joint name="head_yaw_joint" value="0"/>
    <joint name="head_pitch_joint" value="0.35"/>
  </group_state>
  <group_state name="Down" group="camera_head">
    <joint name="head_yaw_joint" value="0"/>
    <joint name="head_pitch_joint" value="-0.35"/>
  </group_state>

  <!-- Non-head movable joints belong to other hardware systems and are not
       controlled by this MoveIt configuration. -->
  <passive_joint name="waist"/>
  <passive_joint name="shoulder"/>
  <passive_joint name="elbow"/>
  <passive_joint name="wrist_angle"/>
  <passive_joint name="wrist_rotate"/>
  <passive_joint name="gripper"/>
  <passive_joint name="left_finger"/>
  <passive_joint name="right_finger"/>
  <passive_joint name="joint_Rear_Left"/>
  <passive_joint name="joint_Front_Right"/>
  <passive_joint name="joint_Front_Left"/>
  <passive_joint name="joint_Rear_Right"/>

  <disable_collisions link1="alu3030_blue_camera_top" link2="head_yaw_link" reason="Adjacent"/>
  <disable_collisions link1="head_yaw_link" link2="head_pitch_link" reason="Adjacent"/>
  <disable_collisions link1="head_pitch_link" link2="camera_bottom_screw_frame" reason="Adjacent"/>
  <disable_collisions link1="head_pitch_link" link2="camera_link" reason="Adjacent"/>
  <disable_collisions link1="camera_bottom_screw_frame" link2="camera_link" reason="Adjacent"/>
</robot>
