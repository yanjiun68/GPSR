<?xml version="1.0"?>
<!-- Two-axis STS pan/tilt camera head. +X forward, +Y left, +Z up.
     Simulation uses +Y for pitch; the reference STS hardware configuration
     uses -Y and therefore requires sign calibration before hardware use. -->
<robot xmlns:xacro="http://ros.org/wiki/xacro">
  <xacro:macro name="head_2axis" params="parent">
    <material name="head_motor_black">
      <color rgba="0.08 0.08 0.08 1"/>
    </material>

    <link name="head_yaw_link">
      <visual>
        <geometry><box size="0.038 0.0225 0.031"/></geometry>
        <material name="head_motor_black"/>
      </visual>
      <collision>
        <geometry><box size="0.038 0.0225 0.031"/></geometry>
      </collision>
      <inertial>
        <origin xyz="0 0 0"/>
        <mass value="0.15"/>
        <inertia ixx="0.000018330" ixy="0" ixz="0"
                 iyy="0.000030024" iyz="0" izz="0.000024375"/>
      </inertial>
    </link>
    <joint name="head_yaw_joint" type="revolute">
      <parent link="${parent}"/>
      <child link="head_yaw_link"/>
      <origin xyz="0 0 0.036" rpy="0 0 0"/>
      <axis xyz="0 0 1"/>
      <limit lower="-0.7" upper="0.7" effort="2.0" velocity="1.0"/>
      <dynamics damping="0.08" friction="0.02"/>
    </joint>

    <link name="head_pitch_link">
      <visual>
        <geometry><box size="0.04662 0.0378 0.062"/></geometry>
        <material name="head_motor_black"/>
      </visual>
      <visual>
        <origin xyz="0 0 0.0725" rpy="0 0 0"/>
        <geometry><box size="0.012 0.012 0.145"/></geometry>
        <material name="head_motor_black"/>
      </visual>
      <collision>
        <geometry><box size="0.04662 0.0378 0.062"/></geometry>
      </collision>
      <collision>
        <origin xyz="0 0 0.0725" rpy="0 0 0"/>
        <geometry><box size="0.012 0.012 0.145"/></geometry>
      </collision>
      <inertial>
        <origin xyz="0 0 0.02"/>
        <mass value="0.20"/>
        <inertia ixx="0.00015" ixy="0" ixz="0"
                 iyy="0.00015" iyz="0" izz="0.000055"/>
      </inertial>
    </link>
    <joint name="head_pitch_joint" type="revolute">
      <parent link="head_yaw_link"/>
      <child link="head_pitch_link"/>
      <origin xyz="0 0 0.025" rpy="0 0 0"/>
      <axis xyz="0 1 0"/>
      <limit lower="-0.6" upper="0.6" effort="2.0" velocity="1.0"/>
      <dynamics damping="0.08" friction="0.02"/>
    </joint>
  </xacro:macro>
</robot>
