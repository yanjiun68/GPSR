<?xml version="1.0"?>
<package format="3">
  <name>receptionist_nodes</name>
  <version>0.0.1</version>
  <description>Python support nodes for receptionist task</description>

  <maintainer email="you@example.com">you</maintainer>
  <license>Apache-2.0</license>
  <export>
    <build_type>ament_python</build_type>
  </export>
  
  <buildtool_depend>ament_python</buildtool_depend>

  <depend>rclpy</depend>
  <depend>geometry_msgs</depend>
  <depend>nav2_msgs</depend>
  <depend>putrabot_interfaces</depend>
  <depend>interbotix_xs_msgs</depend>
  <depend>std_msgs</depend>
  <depend>builtin_interfaces</depend>
  <depend>robot_ai_interfaces</depend>
  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>face_detection</exec_depend>
  <exec_depend>voice</exec_depend>

  <exec_depend>python3</exec_depend>
  <exec_depend>python3-yaml</exec_depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>
</package>
