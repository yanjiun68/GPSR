<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>insightface_feature_summary_smacc2</name>
  <version>0.1.0</version>
  <description>Lifecycle-managed YASMIN task that summarizes InsightFace appearance features through TTS.</description>
  <maintainer email="yanjiun68@todo.todo">yanjiun68</maintainer>
  <license>Apache-2.0</license>

  <!-- Build system dependency. -->
  <buildtool_depend>ament_cmake</buildtool_depend>

  <!-- Compile dependencies used by the lifecycle process supervisor. -->
  <depend>ament_index_cpp</depend>
  <depend>nav2_util</depend>
  <depend>rclcpp</depend>
  <depend>rclcpp_lifecycle</depend>

  <!-- Runtime dependencies used by the Python YASMIN state machine. -->
  <exec_depend>rclpy</exec_depend>
  <exec_depend>robot_ai_interfaces</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>voice_interfaces</exec_depend>
  <exec_depend>yasmin</exec_depend>
  <exec_depend>yasmin_ros</exec_depend>
  <exec_depend>yasmin_viewer</exec_depend>

  <!-- Launch-time packages started or managed by this package. -->
  <exec_depend>face_detection</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>nav2_lifecycle_manager</exec_depend>
  <exec_depend>voice</exec_depend>

  <!-- Standard ROS 2 lint dependencies. -->
  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
