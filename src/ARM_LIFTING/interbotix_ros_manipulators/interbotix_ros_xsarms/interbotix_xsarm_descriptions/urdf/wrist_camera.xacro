<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:arg name="wrist_camera_x" default="-0.015"/>
  <xacro:arg name="wrist_camera_y" default="0.0"/>
  <xacro:arg name="wrist_camera_z" default="0.045"/>
  <xacro:arg name="wrist_camera_roll" default="0.0"/>
  <xacro:arg name="wrist_camera_pitch" default="0.0"/>
  <xacro:arg name="wrist_camera_yaw" default="0.0"/>
  <xacro:property name="camera_width" value="0.035"/>
  <xacro:property name="camera_height" value="0.025"/>
  <xacro:property name="camera_depth" value="0.025"/>
  <xacro:property name="camera_mass" value="0.03"/>
  <link name="$(arg robot_name)/wrist_camera_link">
    <visual><geometry><box size="${camera_width} ${camera_height} ${camera_depth}"/></geometry><material name="wrist_camera_black"><color rgba="0.04 0.04 0.04 1"/></material></visual>
    <collision><geometry><box size="${camera_width} ${camera_height} ${camera_depth}"/></geometry></collision>
    <inertial><mass value="${camera_mass}"/><inertia ixx="${camera_mass/12.0*(camera_height*camera_height+camera_depth*camera_depth)}" ixy="0" ixz="0" iyy="${camera_mass/12.0*(camera_width*camera_width+camera_depth*camera_depth)}" iyz="0" izz="${camera_mass/12.0*(camera_width*camera_width+camera_height*camera_height)}"/></inertial>
  </link>
  <joint name="$(arg robot_name)/wrist_camera_joint" type="fixed">
    <parent link="$(arg robot_name)/ee_gripper_link"/><child link="$(arg robot_name)/wrist_camera_link"/>
    <origin xyz="$(arg wrist_camera_x) $(arg wrist_camera_y) $(arg wrist_camera_z)" rpy="$(arg wrist_camera_roll) $(arg wrist_camera_pitch) $(arg wrist_camera_yaw)"/>
  </joint>
  <link name="$(arg robot_name)/wrist_camera_optical_frame"/>
  <joint name="$(arg robot_name)/wrist_camera_optical_joint" type="fixed">
    <parent link="$(arg robot_name)/wrist_camera_link"/><child link="$(arg robot_name)/wrist_camera_optical_frame"/>
    <origin xyz="0 0 0" rpy="-1.57079632679 0 -1.57079632679"/>
  </joint>
</robot>
