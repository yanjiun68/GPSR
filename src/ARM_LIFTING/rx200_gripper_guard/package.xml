<?xml version="1.0"?>
<!-- Section: Runtime package for guarded RX200 gripper control. -->
<package format="3">
  <name>rx200_gripper_guard</name>
  <version>0.1.0</version>
  <description>Feedback-aware guarded closing and health diagnostics for the RX200 gripper.</description>
  <maintainer email="yanjiun68@example.com">yanjiun68</maintainer>
  <license>Apache-2.0</license>

  <!-- Section: Python runtime and existing Interbotix ROS interface dependencies. -->
  <buildtool_depend>ament_python</buildtool_depend>
  <exec_depend>diagnostic_msgs</exec_depend>
  <exec_depend>interbotix_xs_msgs</exec_depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>rx200_gripper_guard_interfaces</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>std_msgs</exec_depend>

  <!-- Section: Deterministic unit and style tests. -->
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
