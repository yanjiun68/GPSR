<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>waypoint_saver</name>
  <version>0.1.0</version>
  <description>Isolated ROS 2 service that saves the current TF pose to a requested waypoint YAML file.</description>

  <maintainer email="jie@todo.todo">jie</maintainer>
  <license>Apache-2.0</license>

  <!-- Section: Build the package and its custom SaveWaypoint service. -->
  <buildtool_depend>ament_cmake</buildtool_depend>
  <build_depend>rosidl_default_generators</build_depend>

  <!-- Section: Provide message, node, TF, and YAML runtime support. -->
  <depend>geometry_msgs</depend>
  <exec_depend>python3-yaml</exec_depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>rosidl_default_runtime</exec_depend>
  <exec_depend>tf2_ros</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>

  <!-- Section: Run deterministic helper and mocked-TF tests without hardware. -->
  <test_depend>ament_cmake_pytest</test_depend>
  <test_depend>python3-pytest</test_depend>

  <!-- Section: Register this package as a ROS interface provider. -->
  <member_of_group>rosidl_interface_packages</member_of_group>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
