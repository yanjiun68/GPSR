<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>vision</name>
  <version>0.0.0</version>
  <description>Vision perception nodes, interfaces, and persistent human identity support.</description>
  <maintainer email="nichosion@todo.todo">nichosion</maintainer>
  <license>TODO: License declaration</license>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <buildtool_depend>ament_cmake_python</buildtool_depend>
  <build_depend>rosidl_default_generators</build_depend>
  <exec_depend>rosidl_default_runtime</exec_depend>

  <build_depend>builtin_interfaces</build_depend>
  <exec_depend>builtin_interfaces</exec_depend>

  <build_depend>rclpy</build_depend>
  <exec_depend>rclpy</exec_depend>

  <exec_depend>lifecycle_msgs</exec_depend>

  <member_of_group>rosidl_interface_packages</member_of_group>


  <depend>rclcpp</depend>
  <depend>ament_index_python</depend>
  <depend>sensor_msgs</depend>
  <exec_depend>sensor_msgs_py</exec_depend>
  <depend>visualization_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>std_msgs</depend>
  <depend>tf2_ros</depend>
  <depend>tf2_geometry_msgs</depend>
  <depend>putrabot_interfaces</depend>
  <depend>robot_ai_interfaces</depend>
  <depend>robot_yasmin_tasks</depend>
  <depend>voice</depend>
  <depend>voice_interfaces</depend>
  <depend>cv_bridge</depend>
  <!-- The Astra adapter launches the camera driver and reports stream health. -->
  <exec_depend>astra_camera</exec_depend>
  <exec_depend>diagnostic_msgs</exec_depend>
  <depend>image_transport</depend>
  <depend>OpenCV</depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>
  <test_depend>ament_cmake_pytest</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
