# Request section: recording duration in seconds; values at or below zero use the node default.
float32 record_sec
# Request section: ALSA capture device; an empty value uses the node default.
string mic_device
# Request section: faster-whisper model name; an empty value uses the node default.
string whisper_model
# Request section: language hint; an empty value enables automatic language detection.
string whisper_language
# Request section: output WAV path; an empty value uses the node default.
string wav_path
---
# Response section: true when recording and transcription both succeed.
bool success
# Response section: recognized speech text.
string transcript
# Response section: operator-facing completion or failure description.
string message
# Response section: WAV file used for transcription.
string wav_path
